# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://closer.app"

# Firebase Client Configuration (Vite client-side)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Optional Creator Default Email for fallback notifications
VITE_CREATOR_DEFAULT_EMAIL=""

# ImageKit Free Plan for Optional Recipient Photo Storage ($0/month, No Credit Card Required)
# Sign up free at imagekit.io to get your public key, private key, and URL endpoint
VITE_IMAGEKIT_ID=""
VITE_IMAGEKIT_PUBLIC_KEY=""
VITE_IMAGEKIT_PRIVATE_KEY=""
VITE_IMAGEKIT_URL_ENDPOINT=""
